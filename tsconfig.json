{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx", "tests/types/**/*.ts"]
}
