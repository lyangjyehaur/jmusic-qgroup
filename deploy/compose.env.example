# Docker Compose 設定範例。部署時複製成專案根目錄的 .env（不進 Git）。
#   cp deploy/compose.env.example /opt/qgroup/.env && chmod 600 /opt/qgroup/.env
# 這裡不放任何憑證；AppID／Secret／管理金鑰仍在 /etc/qgroup/*.env。

# --- 必須與宿主機 /var/lib/qgroup 的檔案擁有者一致 ---
# server2 靜態帳號 qgroupsvc：id qgroupsvc 可得 uid / gid
QGROUP_UID=994
QGROUP_GID=992

# --- 映像標籤：每次部署換成版號或 commit，方便回滾 ---
QGROUP_TAG=local

# --- 資料目錄（SQLite + images/ + WAL/SHM），必須是 bind mount ---
# 宿主機的 qgroup-backup.service 直接讀這個路徑，不要改成 named volume。
QGROUP_DATA_DIR=/var/lib/qgroup

# --- 憑證檔目錄 ---
QGROUP_ENV_DIR=/etc/qgroup

# --- 網站監聽（host networking，1Panel 上游指向 127.0.0.1:8791）---
# 隔離驗證時可改成 8792，避免與既有服務抢同一個埠。
KANBAN_PORT=8791
KANBAN_ORIGIN=https://kanban.danndann.cn
