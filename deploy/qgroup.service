[Unit]
Description=Together activity board
After=network.target

[Service]
Type=simple
# 與 qgroup-bot.service 共用同一個靜態帳號，兩者才能讀寫同一個 SQLite。
# 若原本是 DynamicUser，systemd 會在首次啟動時自動把 /var/lib/private/qgroup
# 遷移到 /var/lib/qgroup 並設為該使用者所有（兩個服務共用同一目錄）。
User=qgroupsvc
Group=qgroupsvc
WorkingDirectory=/opt/qgroup
StateDirectory=qgroup
UMask=0077
Environment=KANBAN_DB=/var/lib/qgroup/kanban.sqlite3
Environment=KANBAN_HOST=127.0.0.1
Environment=KANBAN_PORT=8791
Environment=KANBAN_SECURE_COOKIE=1
Environment=KANBAN_ORIGIN=https://kanban.danndann.cn
EnvironmentFile=-/etc/qgroup/qq.env
EnvironmentFile=-/etc/qgroup/admin.env
EnvironmentFile=-/etc/qgroup/public-api.env
ExecStart=/usr/bin/python3 /opt/qgroup/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
