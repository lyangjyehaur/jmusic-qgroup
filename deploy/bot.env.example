# qgroup-bot 設定範例。
# 部署位置：/etc/qgroup/bot.env（chmod 600，root 擁有），由 qgroup-bot.service 的 EnvironmentFile 讀入。
# 本檔只是範例，不含任何真實憑證；AppSecret 只應存在伺服器上，不進 Git、不進對話。

# --- 必要：q.qq.com 管理端「開發設定」取得 ---
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# --- 必要：與 qgroup.service 指向「同一個」SQLite 檔案 ---
KANBAN_DB=/var/lib/qgroup/kanban.sqlite3

# --- 必要：主要使用群的 group_openid（由群事件或 tools/qq_bot_probe.py 取得） ---
KANBAN_BOT_GROUP=

# --- 安全開關：預設 1，只記 log 不真的發訊息 ---
# 確認 outbox 內容與群組無誤後才改成 0。
KANBAN_BOT_DRY_RUN=1

# --- 選配 ---
# bot 未上線、只能連沙箱時設 1
# QQBOT_SANDBOX=1
# 輪詢間隔（秒）、每批筆數、最大重試次數、卡住 claim 的回收秒數
# KANBAN_BOT_POLL_INTERVAL=5
# KANBAN_BOT_BATCH=10
# KANBAN_BOT_MAX_ATTEMPTS=5
# KANBAN_BOT_CLAIM_TIMEOUT=600
# 註冊官方指令面板（建議先在管理端確認面板 API 格式）
# KANBAN_BOT_SETUP_PANELS=1
# 在活動卡／結算卡附 keyboard 按鈕（官方文件寫「僅 markdown 支援」，需實測）
# KANBAN_BOT_KEYBOARD=1
# 除錯用：印出所有事件
# KANBAN_BOT_VERBOSE=1

# ============================================================
# 以下設定屬於「主服務」qgroup.service，不是 bot 行程，
# 請加到 /etc/qgroup/qq.env 或 qgroup.service 的 Environment=：
# ============================================================
# KANBAN_BOT_ENABLED=1                 # 沒設這行，主服務完全不寫 outbox（預設關閉）
# KANBAN_BOT_BASE_URL=https://kanban.danndann.cn
# KANBAN_BOT_SCHEDULE=1               # 截止前 24h / 預計結束提醒（時間驅動）
# KANBAN_BOT_SETTLEMENT_DETAIL=0      # 1 = 群訊息列出逐人金額（預設 0，只給站內連結）
# KANBAN_BOT_PERSONAL_QUEUE=0         # 1 = 把點名通知排入 private 通道（尚無身份綁定）
# KANBAN_BOT_BROADCAST_KINDS=         # 留空用預設；逗號分隔可自行增減廣播節點
