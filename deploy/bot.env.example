# qgroup-bot 設定範例。
# 部署位置：/etc/qgroup/bot.env（chmod 600，root 擁有），
# 由 compose.yaml 的 env_file（或舊版 qgroup-bot.service 的 EnvironmentFile）讀入。
# 本檔只是範例，不含任何真實憑證；AppSecret 只應存在伺服器上，不進 Git、不進對話。

# --- 必要：q.qq.com 管理端「開發設定」取得 ---
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# --- 必要：與 qgroup.service 指向「同一個」SQLite 檔案 ---
KANBAN_DB=/var/lib/qgroup/kanban.sqlite3

# --- 舊部署預設群：僅在後台尚未保存群組政策時使用，可留空 ---
# 後台「群組管理」可逐群允許 @ 回覆、單獨選擇一個主動通知目標。
# 新發現群預設停用；空的後台群組列表表示全部停用，不回退此值。
# 群事件中的 group_openid 不是 QQ 群號。
KANBAN_BOT_GROUP=

# --- 部署層預設值：只在後台「發送模式＝沿用部署設定」時生效 ---
# 管理後台「機器人設定」的版本化政策是唯一事實來源，兩個行程每次操作都讀最新設定；
# 後台明確選「實際發送」會覆蓋此值，不需要改 env、不需要重建容器。
#   replies_enabled=1、發送模式=實際發送、廣播 enabled=0 → 只回被動 @，主動推送不發
#   廣播 enabled=1、發送模式=實際發送                  → 被動回覆與選定節點都真發
# 協定修補已完成；切換前仍須確認群主已在群內 bot 權限頁開啟「機器人主動在群聊內發言」。
# 選「沿用部署設定」時由此值決定：1 全模擬，0 才依後台其他開關實際發送。
KANBAN_BOT_DRY_RUN=1

# --- 選配 ---
# 統一 API 網域（2026-08-10 changelog）；新主站連不上會自動回退 api.sgroup.qq.com
# KANBAN_BOT_API_BASE=https://api.bot.qq.com
# 主動訊息 URL 白名單（逗號分隔）。留空不檢查；設定後才拒送未報備網域
# KANBAN_BOT_ALLOWED_HOSTS=kanban.danndann.cn
# bot 未上線、只能連沙箱時設 1
# QQBOT_SANDBOX=1
# 輪詢間隔（秒）、每批筆數、最大重試次數、卡住 claim 的回收秒數
# KANBAN_BOT_POLL_INTERVAL=5
# KANBAN_BOT_BATCH=10
# KANBAN_BOT_MAX_ATTEMPTS=5
# KANBAN_BOT_CLAIM_TIMEOUT=600
# 註冊官方指令面板（建議先在管理端確認面板 API 格式）
# KANBAN_BOT_SETUP_PANELS=1
# 在活動卡／結算卡附 keyboard 按鈕（官方群訊息 schema 允許訊息附 keyboard，
# 範例即 Markdown + 鍵盤；實際按鈕行為仍需手機實測）
# KANBAN_BOT_KEYBOARD=1
# 自訂 Markdown（msg_type=2）：被動 @ 指令回覆與 14 類主動廣播卡片。
# 官方自 2026-04-23 起群聊／單聊自訂 Markdown 全量開放，不需申請模板。
# 預設 0 維持純文字；設定變更後須 --force-recreate bot（restart 不重載 env_file）。
# 實機驗收前建議維持 0，正式群 dry_run=false 時更應先在測試群看過一次。
# KANBAN_BOT_MARKDOWN=1
# 除錯用：額外記錄事件種類與欄位名稱；收訊、@ 判斷、回覆及投遞平時也會記錄
# KANBAN_BOT_VERBOSE=1
# 結構化日誌同時寫到 Docker 輸出與此持久目錄；預設為 SQLite 同目錄下的 bot-logs
# 每檔 5 MiB，含目前檔共保留 5 份；檔案權限 0600
# KANBAN_BOT_LOG_DIR=/var/lib/qgroup/bot-logs
# 短期排查才開正文預覽：只記被處理的指令和 bot 輸出，URL／常見憑證會遮罩
# KANBAN_BOT_LOG_CONTENT=0
# KANBAN_BOT_LOG_CONTENT_LIMIT=500     # 每則最多 500 字，允許範圍 80–2000

# ============================================================
# 以下是「後台尚未保存設定」時兩個行程共用的部署預設值。
# 主要寫在 /etc/qgroup/qq.env（web）；bot 行程也會讀其中部分變數
# （BASE_URL 用於 /帮助、BROADCAST_KINDS 用於首次預設），需要兩行程一致時
# 請在 bot.env 也寫入相同值。後台保存過一次設定後，即改以資料庫中的
# 版本化政策為準，這些值不再影響行為。
# ============================================================
# KANBAN_BOT_ENABLED=1                 # 首次未保存時的廣播預設開關；發起者還需逐場開啟群同步（預設關閉）
#                                      # 兩個行程都讀此值：若 qq.env 設了 1，bot.env 也要設 1，
#                                      # 或直接在後台存一次設定（推薦，之後完全以資料庫為準）。
# KANBAN_BOT_BASE_URL=https://kanban.danndann.cn
# KANBAN_BOT_SCHEDULE=1               # 截止前 24h / 預計結束提醒（時間驅動）
# KANBAN_BOT_SETTLEMENT_DETAIL=0      # 1 = 群訊息列出逐人金額（預設 0，只給站內連結）
# KANBAN_BOT_PERSONAL_QUEUE=0         # 1 = 把點名通知排入 private 通道（尚無身份綁定）
# KANBAN_BOT_BROADCAST_KINDS=         # 留空用預設；逗號分隔可自行增減廣播節點

# 改 env_file 後用 docker compose up -d --force-recreate bot（或 web）載入；restart 不更新環境。
# 後台「機器人設定」的版本化政策由兩個行程每次操作讀取，修改後即時生效，不需重建容器。
# 模擬紀錄不會自動回放；活動發起者可在投遞紀錄手動重送。
