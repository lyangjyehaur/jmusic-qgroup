# A Dockerfile-specific allowlist; the legacy Python context is unchanged.
**
!package.json
!package-lock.json
!tsconfig.rebuild.json
!release-source.json
!apps/
!apps/**
!packages/
!packages/**
!tools/
!tools/rebuild/
!tools/rebuild/build-api.mjs
!tools/rebuild/build-http-contracts.ts
!tools/rebuild/http-openapi.ts
!tools/rebuild/http-access.ts
!tools/rebuild/schemas/
!tools/rebuild/schemas/openapi-3.1.json
!tools/rebuild/schemas/http-access-review.json
!tools/rebuild/build-analytics-manifest.ts
!tools/rebuild/build-error-displays.ts
!deploy/
!deploy/unified.Dockerfile
!deploy/unified.Dockerfile.dockerignore
**/*.test.ts
**/testsupport/
**/tests/
**/node_modules/
**/.env*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.log
