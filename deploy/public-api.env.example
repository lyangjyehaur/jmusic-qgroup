# Copy to /etc/qgroup/public-api.env, owned by root with mode 0600.
# Set independently generated keys (python3 -c 'import secrets; print(secrets.token_urlsafe(32))').
# Comma-separated keys allow per-partner revocation and staged rotation (max 20).
# Empty or malformed configuration disables the partner API with HTTP 503.
# Recreate only web (Compose), or restart qgroup.service, after changing this file.
KANBAN_PUBLIC_API_KEYS=
