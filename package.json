{
  "name": "qgroup-build-tools",
  "private": true,
  "engines": { "node": ">=22.22.3", "npm": ">=10.9.8" },
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build:locales": "node deploy/build_locales.cjs",
    "build:ui": "npm run typecheck && node deploy/build_ui.mjs",
    "build": "npm run build:locales && npm run build:ui && npm run build:locales",
    "check:ui": "npm run typecheck && node deploy/build_ui.mjs --check",
    "test:ui": "npm run typecheck && node tests/test_board_react.mjs && node tests/test_react_controllers.mjs && node tests/test_music_selection.mjs && node tests/test_yahha_patterns.mjs && node tests/test_react_ui.mjs",
    "typecheck": "tsc --noEmit",
    "restore:rebuild": "tsx tools/rebuild/restore-backup.ts",
    "import:rebuild": "tsx tools/migration/import-snapshot.ts",
    "capture:rebuild": "tsx tools/migration/capture-snapshot.ts",
    "verify:rollback": "tsx tools/migration/read-rollback-package.ts",
    "inspect:rollback": "tsx tools/migration/rollback-service-evidence.ts",
    "capture:rollback": "tsx tools/migration/capture-rollback-package.ts",
    "restore:rollback-bot": "tsx tools/migration/rollback-bot-restore.ts",
    "verify:rollback-bot": "tsx tools/migration/read-rollback-bot-restore.ts",
    "prepare:rollback-history": "tsx tools/migration/rollback-history-catalog.ts",
    "dev:rebuild": "node tools/rebuild/dev.mjs",
    "start:rebuild": "tsx apps/api/src/start.ts",
    "typecheck:rebuild": "tsc -p tsconfig.rebuild.json",
    "test:rebuild": "vitest run --config vitest.rebuild.config.ts",
    "build:analytics:rebuild": "tsx tools/rebuild/build-analytics-manifest.ts",
    "build:error-displays:rebuild": "tsx tools/rebuild/build-error-displays.ts",
    "build:rebuild": "npm run build:error-displays:rebuild && npm run build:analytics:rebuild && npm run typecheck:rebuild && vite build --config apps/web/vite.config.ts && node tools/rebuild/build-api.mjs",
    "test:e2e:rebuild": "playwright test --config apps/web/playwright.config.ts",
    "test:build:rebuild": "node tools/rebuild/smoke-build.mjs",
    "check:capabilities": "node tools/rebuild/check-capabilities.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.27.0",
    "html-react-parser": "5.2.10",
    "opencc-js": "1.4.2",
    "postcss": "8.5.33",
    "typescript": "5.9.3",
    "yahha-ui": "0.2.0",
    "@types/better-sqlite3": "9.6.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "fastify": "5.12.8",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.11",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/helmet": "13.2.0",
    "better-sqlite3": "13.2.0",
    "react-router-dom": "7.18.5",
    "@tanstack/react-query": "5.107.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
